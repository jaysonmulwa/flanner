# Flanner configuration (all optional)

# Data directory: database and storage live here (default: ~/.flanner)
# FLANNER_HOME=/custom/flanner/home

# Database file path; overrides FLANNER_HOME/data.db when set
# FLANNER_DB_PATH=/custom/path/to/data.db

# Web UI port for `flanner web` (default: 8080)
# FLANNER_WEB_PORT=8080

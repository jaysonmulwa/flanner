# MCP Plan Manager Configuration

# Database path (defaults to ~/.mcp-plans/data.db)
# DATABASE_PATH=/custom/path/to/data.db

# Default plan directory (relative to project root)
# DEFAULT_PLAN_DIRECTORY=.plans

# Web server port
# WEB_PORT=8080

# Enable debug mode
# DEBUG=false

# Auto-update .gitignore
# AUTO_GITIGNORE=true
